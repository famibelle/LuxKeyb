<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le micro, pour écouter la réunion ; le réseau, pour LuxASR et Claude. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- L'écoute continue écran éteint (service au premier plan, type micro),
         et la préparation du compte rendu continue application fermée
         (service au premier plan, type synchronisation de données). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Rien n'est sauvegardé hors du téléphone : ni les réunions, ni la clé. -->
    <application
        android:name=".ReunionApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/aucune_sauvegarde"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Lëtzebuergesch Réunion"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reunion">

        <activity
            android:name=".AccueilActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PreparationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DirectActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ReunionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReglagesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ServiceEcoute"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".ServiceTraitement"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
