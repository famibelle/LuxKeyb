<!--
    Icône de statut de la notification de passage de niveau.

    Android n'affiche qu'une silhouette : il ignore les couleurs et ne garde
    que le canal alpha. Une icône de lanceur en couleurs (ic_launcher) y
    apparaît donc comme un carré plein illisible — d'où ce tracé monochrome
    dédié. Flèche vers le haut : la progression, indépendamment du niveau
    atteint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3.5 L21,12.5 L15.5,12.5 L15.5,20.5 L8.5,20.5 L8.5,12.5 L3,12.5 Z" />
</vector>
