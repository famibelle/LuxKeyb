<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde Android jusqu'à Android 11 (au-delà, voir data_extraction_rules.xml,
    qui doit dire exactement la même chose).

    Liste blanche : seuls les réglages quittent le téléphone. La politique de
    confidentialité publiée promet que la progression, le carnet et tout ce qui
    vient de la frappe « ne quittent jamais votre appareil ». Une règle
    include path="." envoyait tout le reste aussi, dont les emojis récents,
    qui sont une trace de frappe. Ne rien ajouter ici qui ne soit pas un
    réglage choisi par l'utilisateur ; BackupRulesTest le vérifie.
-->
<full-backup-content>
    <!-- Vibration, son, thème (KeyboardPreferences). -->
    <include domain="sharedpref" path="kreyol_clavier_prefs.xml"/>
    <!-- Majuscule automatique (KreyolInputMethodServiceRefactored.KEYBOARD_PREFS_NAME). -->
    <include domain="sharedpref" path="lux_keyboard_prefs.xml"/>
</full-backup-content>
