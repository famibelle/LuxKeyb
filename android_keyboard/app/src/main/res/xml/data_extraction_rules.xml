<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde Android 12 et plus : cloud ET transfert d'appareil à appareil.
    Même liste blanche que backup_rules.xml, et pour la même raison : la
    politique de confidentialité promet que la progression, le carnet et tout
    ce qui vient de la frappe ne sont « pas synchronisés avec le cloud ou
    d'autres appareils ». Seuls les réglages partent. BackupRulesTest le vérifie.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="kreyol_clavier_prefs.xml"/>
        <include domain="sharedpref" path="lux_keyboard_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="kreyol_clavier_prefs.xml"/>
        <include domain="sharedpref" path="lux_keyboard_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
