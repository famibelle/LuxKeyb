<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Défilement des Réglages du clavier : un identifiant fixe, pour que la
         position survive à la recréation de l'écran quand on change la langue
         de l'interface, choix placé tout en bas. -->
    <item name="reglages_defilement" type="id" />

    <!-- Le cadre où s'ouvre un jeu, sous l'onglet Spiller : un identifiant
         fixe, pour que le jeu restauré après une rotation retrouve son cadre
         et garde sa partie. Un identifiant tiré au hasard le perdait. -->
    <item name="conteneur_jeu" type="id" />

    <!-- Les quatre onglets : sans identifiant, ViewPager2 n'enregistre pas
         les pages qu'il porte, et une rotation les recréait toutes à neuf,
         jeu en cours compris. -->
    <item name="onglets" type="id" />

    <!-- Le champ de recherche du Wierderbuch : un identifiant fixe pour que
         la requête survive à une rotation. -->
    <item name="recherche_wierderbuch" type="id" />
</resources>
