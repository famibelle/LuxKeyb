<resources>
    <string name="app_name">Lëtzebuergesch Clavier</string>
    <string name="app_name_full">Lëtzebuergesch Clavier • Luxembourg</string>
    <!-- Le nom de la liste des claviers d'Android : celui que les consignes de
         l'application demandent de choisir, mot pour mot (v29.4.1). -->
    <string name="keyboard_name">Lëtzebuergesch Clavier</string>
    <string name="keyboard_description">Clavier luxembourgeois avec suggestions de mots et accents</string>
    <string name="settings_title">Paramètres Lëtzebuergesch Clavier</string>
    <string name="spell_checker_name">Correcteur Lëtzebuergesch</string>
    <string name="spellchecker_name">Correcteur Lëtzebuergesch • Luxembourg</string>
    <string name="subtype_kreyol">Lëtzebuergesch Clavier Luxembourg</string>
    <string name="subtype_kreyol_description">Lëtzebuergesch</string>

    <!-- Astuce montrée une seule fois, au premier usage réel du clavier. Elle
         était restée en créole guadeloupéen, avec les accents du créole
         (é, è, ò) : le tout premier message qu'un nouvel utilisateur
         luxembourgeois voyait. Les exemples sont désormais ceux que l'appui
         long donne réellement ici — é, ä et ë ont leur propre touche. -->
    <string name="first_use_accent_tip">Appui long sur une lettre pour ses accents (è, ê, ü, ö…)</string>

    <!-- Dictée vocale luxembourgeoise (whisper tiny embarqué, hors ligne) -->
    <string name="stt_mic_description">Dictée vocale</string>
    <!-- Bandeau affiché à la place des suggestions pendant la dictée.
         En luxembourgeois : il s'adresse à quelqu'un qui est en train de
         parler sa langue, et il doit tenir sur une rangée de clavier. -->
    <string name="stt_preparing">🎙️ Moment…</string>
    <string name="stt_listening">🎙️ Schwätzt…</string>
    <string name="stt_transcribing">✍️ Transkriptioun…</string>

    <!-- Bandeau de la dictée EN LIGNE (branche de démonstration LuxASR). Le globe
         et la mention du service sont là pour qu'on ne puisse pas confondre avec
         la dictée embarquée : l'audio part sur un serveur tiers. -->
    <string name="stt_online_connecting">🌐 LuxASR verbannen…</string>
    <string name="stt_online_listening">🌐 LuxASR · Schwätzt…</string>
    <string name="stt_online_transcribing">🌐 LuxASR · Transkriptioun…</string>
    <!-- Remplace « Schwätzt… » quand l'audio s'empile faute de réseau : le texte
         arrivera en retard. À faire relire par un locuteur. -->
    <string name="stt_online_slow">🐢 LuxASR · lues Verbindung…</string>
    <string name="stt_permission_denied">Dictée impossible sans accès au micro</string>
    <string name="stt_mic_unavailable">Micro indisponible</string>
    <string name="stt_model_unavailable">Dictée indisponible sur cet appareil</string>
    <!-- Branche de démonstration : un échec de connexion n'est PAS une
         incapacité de l'appareil. Réutiliser stt_model_unavailable, comme
         c'était le cas, faisait accuser le téléphone alors que le service ou
         le réseau étaient en cause — constaté sur un vrai téléphone. -->
    <!-- Le réseau est là, le service ne répond pas : ce n'est ni le téléphone
         ni la connexion de l'utilisateur. -->
    <string name="stt_service_unreachable">Service LuxASR indisponible, réessayez plus tard</string>
    <!-- Dictée en ligne, trois autres causes, trois messages : l'utilisateur ne
         peut agir que s'il sait laquelle. Le texte déjà dicté est toujours gardé. -->
    <string name="stt_no_network">Dictée : pas de connexion Internet</string>
    <string name="stt_connection_lost">Connexion perdue pendant la dictée</string>
    <string name="stt_network_too_slow">Connexion trop lente pour la dictée</string>
    <string name="stt_not_in_password">Dictée désactivée dans les champs de mot de passe</string>
</resources>
