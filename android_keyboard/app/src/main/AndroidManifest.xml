<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Seule permission demandée, et seule exercée par le code : la notification
         qui annonce un nouveau niveau de vocabulaire (Android 13+).

         WRITE_USER_DICTIONARY et READ_EXTERNAL_STORAGE ont été retirées en
         10.14.3. La première servait au dictionnaire personnel de la 10.5.0,
         fonction supprimée dès la 10.6.0 ; la seconde n'a jamais eu d'appelant.
         Une permission déclarée est affichée sur la fiche Play et doit être
         justifiée dans la politique de confidentialité : en garder une dont
         aucune ligne ne se sert coûte de la confiance sans rien apporter.
         Ne pas les remettre sans un appelant réel. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Dictée vocale luxembourgeoise (10.17.0). Appelant réel : AudioRecorder,
         via MicPermissionActivity — un IME ne peut pas demander de permission
         d'exécution depuis sa vue de saisie. L'audio ne quitte jamais
         l'appareil : le modèle whisper est embarqué dans l'APK et l'inférence
         est locale, aucune permission réseau n'est déclarée ici. C'est ce qui
         permet à la politique de confidentialité de rester inchangée. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Dictée en ligne LuxASR (branche de démonstration uniquement). L'audio
         quitte l'appareil, ce qui contredit la politique de confidentialité
         publiée : à ne pas fusionner sans l'accord de LuxASR et une politique
         réécrite. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- required=false : sans micro le clavier reste parfaitement utilisable,
         seule la dictée disparaît. Sans cette ligne, Play filtrerait l'app sur
         les appareils sans micro. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="34">

        <!-- Service du clavier IME -->
        <service
            android:name=".KreyolInputMethodServiceRefactored"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Service de vérification orthographique système (spell checker) -->
        <service
            android:name=".KreyolSpellCheckerService"
            android:label="@string/spellchecker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/kreyol_spellchecker" />
        </service>

        <!-- Partage de fichiers (carte de niveau) sans exposer de chemin réel -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Activity de configuration avec 4 onglets -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Réglages du clavier, atteints par l'engrenage du bandeau de
             SettingsActivity. Non exporté : rien d'extérieur n'a à ouvrir cet
             écran, et parentActivityName donne la remontée système. -->
        <activity
            android:name=".KeyboardSettingsActivity"
            android:label="Réglages du clavier"
            android:parentActivityName=".SettingsActivity"
            android:exported="false" />

        <!-- Écran invisible et sans historique : il n'existe que le temps de la
             boîte de dialogue système de permission micro. -->
        <activity
            android:name=".stt.MicPermissionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

    </application>

</manifest>
