# Identifiants de signature de release (build local uniquement).
#
# Copier ce fichier en `keystore.properties` dans le même dossier, puis y mettre
# les vraies valeurs. `keystore.properties` est ignoré par git et ne doit JAMAIS
# être versionné : c'est le seul endroit local où écrire ces identifiants.
#
#   cp keystore.properties.example keystore.properties
#
# En CI (GitHub Actions), ce fichier est absent et les mêmes clés sont lues
# depuis les secrets du dépôt (KEYSTORE_FILE, STORE_PASSWORD, KEY_ALIAS,
# KEY_PASSWORD). Sans l'un des quatre, le build retombe sur la signature debug.
#
# Ordre de lecture dans app/build.gradle :
#   keystore.properties  >  gradle.properties  >  variables d'environnement

# Chemin du keystore, relatif au module app/
KEYSTORE_FILE=potomitan-keystore.jks
STORE_PASSWORD=votre_mot_de_passe_keystore
KEY_ALIAS=potomitan-release-key
KEY_PASSWORD=votre_mot_de_passe_cle
